# Safe defaults for local Edge Function development and CI.
# Copy this file to .env.local. The destination is ignored by Git.
LOCAL_PROVIDER_MOCKS=false
# The delivery function requires HTTPS even when the local provider is mocked.
# This reserved domain is a placeholder; no invitation email is sent in mock tests.
INVITATION_BASE_URL=https://example.invalid/invitations
INVITATION_FROM_EMAIL=TripSplit Local <noreply@example.com>

# Optional development-only provider credentials. Leave these unset for normal local
# work and automated tests. Never commit real values.
# RESEND_API_KEY=
# GOOGLE_VISION_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
